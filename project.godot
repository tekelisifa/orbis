; Orbis — jeu de fusion d'orbes dans une arène néon
; Godot 4.3 (Android, portrait)

config_version=5

[application]

config/name="Orbis"
config/description="Fusionne les orbes, fais tourner l'arène, atteins la forme finale."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.016, 0.02, 0.05, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Sfx="*res://scripts/sfx.gd"
Save="*res://scripts/save.gd"
Art="*res://scripts/art.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
2d/default_gravity=1400.0
2d/solver/solver_iterations=24

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.016, 0.02, 0.05, 1)
